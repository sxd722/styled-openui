{
  "name": "@openui-style/TEMPLATE",
  "version": "0.1.0",
  "description": "TEMPLATE-style component library for OpenUI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./genui-lib": {
      "import": { "types": "./dist/genui-lib/index.d.ts", "default": "./dist/genui-lib/index.js" },
      "require": { "types": "./dist/genui-lib/index.d.cts", "default": "./dist/genui-lib/index.cjs" }
    },
    "./genui-lib/prompt-options": {
      "import": { "types": "./dist/genui-lib/prompt-options/index.d.ts", "default": "./dist/genui-lib/prompt-options/index.js" },
      "require": { "types": "./dist/genui-lib/prompt-options/index.d.cts", "default": "./dist/genui-lib/prompt-options/index.cjs" }
    },
    "./defaults.css": "./dist/defaults.css",
    "./styles/index.css": "./dist/styles/index.css",
    "./styles/layered.css": "./dist/layered/styles/index.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "node ../../tooling/build-css.mjs && tsdown && node ../../tooling/fix-dts.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openui-style/core": "workspace:^"
  },
  "peerDependencies": {
    "@openuidev/react-lang": ">=0.2.5",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@openuidev/react-lang": "^0.2.11",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.86.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.9.0",
    "vitest": "^3.1.0",
    "zod": "^3.25.76"
  }
}
