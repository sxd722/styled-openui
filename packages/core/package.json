{
  "name": "@openui-style/core",
  "version": "0.1.0",
  "description": "Shared runtime utilities for @openui-style component libraries — markup rendering and the style-library factory.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxd722/styled-openui.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown && node ../../tooling/fix-dts.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@openuidev/react-lang": "^0.2.11",
    "react": "^18.3.1 || ^19.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@openuidev/react-lang": "^0.2.11",
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.9.0",
    "zod": "^3.25.76"
  }
}
